# Copy to .env. Environment variables with the same names win over this file.
# fake = no model calls (default, used by CI); claude = real calls through `claude -p`
PROVETID_TRANSPORT=fake
PROVETID_MODEL_CUSTOMER=opus
PROVETID_MODEL_BOT=opus
PROVETID_MODEL_JUDGE=opus
PROVETID_MODEL_CONVERTER=opus
PROVETID_MODEL_PLAN_BUILDER=opus
PROVETID_EFFORT_CUSTOMER=low
PROVETID_EFFORT_BOT=low
PROVETID_EFFORT_JUDGE=medium
PROVETID_EFFORT_CONVERTER=medium
PROVETID_EFFORT_PLAN_BUILDER=high
PROVETID_PARALLEL_CAP=20
PROVETID_CALL_TIMEOUT_S=60
PROVETID_CHAT_TIMEOUT_S=120
# PROVETID_DATA_DIR=/absolute/path/to/data
